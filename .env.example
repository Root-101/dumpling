# Copy to .env (gitignored) for docker compose, or pass these as variables of the shell (they win
# over the .env). The secrets have no default.

# Admin credentials: the only user, the one that signs in to the console
DUMPLING_ADMIN_USER=
DUMPLING_ADMIN_PASSWORD=
# Long random strings, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Encrypts the credentials of the sources and destinations: changing it makes them unreadable
SECRETS_ENCRYPTION_KEY=

# Major version of pg_dump in the image: it dumps servers of this version or older. Changing it
# needs a rebuild: `docker compose up -d --build`
PG_VERSION=18
# Proxies of your own in front of the service that add their entry to X-Forwarded-For; with 0 the
# IP of the connection is used (login and rate limits count per IP)
TRUSTED_PROXIES=0
